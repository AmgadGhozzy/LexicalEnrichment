        "register": "Neutral",
        "primary_sense": "Process",
        "semantic_tags": [
          "perception",
          "senses",
          "awareness"
        ],
        "usage_note": "Often used in formal or careful descriptions of sensory experience.",
        "mnemonic_ar": null
      },
      {
        "sense_no": 2,
        "definition_en": "To understand, interpret, or view someone or something in a particular way.",
        "short_def_en": "to view or interpret",
        "definition_ar": "يفهم او يعتبر شخصا او امرا بطريقة معينة",
        "is_primary": false,
        "register": "Neutral",
        "primary_sense": "Concept",
        "semantic_tags": [
          "opinion",
          "judgement",
          "understanding"
        ],
        "usage_note": "Commonly followed by 'as' (e.g., perceive someone as a threat).",
        "mnemonic_ar": null
      }
    ],
    "collocations": [
